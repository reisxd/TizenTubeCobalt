# TODO(b/450024477): just a shared library once jni migration is complete
shared_library_with_jni("libchrobalt") {
  remove_uncalled_jni = true

  # Optimize at the ThinLTO link step, as Chrome's Android library does
  # (chrome/android/chrome_common_shared_library.gni).
  if (use_thin_lto) {
    configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
    configs += [ "//build/config/compiler:thinlto_optimize_max" ]
  }
  deps = [
    ":app_event_bridge",
    "//cobalt:cobalt_app",
    "//cobalt:common",
    "//cobalt/browser",
    "//cobalt/browser:cobalt_crash_annotations",
    "//cobalt/gpu",
    "//cobalt/renderer",
    "//cobalt/utility",
    "//gpu/command_buffer/service",

    # TODO: what can be removed in the dependencies?
    "//cobalt/shell:cobalt_shell_app",
    "//cobalt/shell:cobalt_shell_lib",
    "//cobalt/shell:pak",
    "//components/crash/android:crash_android",
    "//components/crash/android:jni_headers",
    "//components/crash/content/browser",
    "//components/embedder_support/android:web_contents_delegate",
    "//components/memory_system",
    "//components/minidump_uploader",
    "//components/minidump_uploader:minidump_uploader_jni_headers",
    "//components/thin_webview/internal",
    "//media",
    "//skia",
    "//third_party/blink/public/common",
  ]

  # Explicit dependency required for JNI registration to be able to
  # find the native side functions.
  if (is_component_build) {
    deps += [
      "//device/gamepad",
      "//media/midi",
    ]
  }
  sources = [ "cobalt_library_loader.cc" ]
  configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
  configs += [ "//build/config/android:hide_all_but_jni" ]
  if (is_official_build) {
    configs += [ "//build/config/compiler:strip_debug" ]
  }
  java_targets = [ ":cobalt_apk" ]
}

android_apk("cobalt_apk") {
  apk_name = "Cobalt"
  android_manifest = cobalt_manifest
  android_manifest_dep = ":cobalt_manifest"
  deps = [
    ":coat_assets",
    ":cobalt_apk_java",
    "//components/crash/android:java",
    "//components/crash/core/app:chrome_crashpad_handler_named_as_so",
    "//components/metrics:metrics_java",
  ]

  # This is the packaging strategy used by Chrome on Android L through M. In a
  # production implementation we should consider the N through P or Q+
  # approaches described in docs/android_native_libraries.md.
  loadable_modules = [ "$root_out_dir/libchrome_crashpad_handler.so" ]

  shared_libraries = [ ":libchrobalt" ]
  srcjar_deps = [ ":libchrobalt__jni_registration" ]
  include_size_info = is_official_build
  version_code = "203"
  version_name = "2.0.3"
  keystore_path = "../../../../.android/debug.keystore"
  keystore_name = "androiddebugkey"
  keystore_password = "android"
}

