[
    Exposed=Window,
    SecureContext
]
interface H5vccTizenTube {
  [CallWith=ScriptState, RaisesException]
  boolean InstallAppFromURL(DOMString url);
  [CallWith=ScriptState, RaisesException]
  DOMString GetVersion();
  [CallWith=ScriptState, RaisesException]
  DOMString GetArchitecture();
  void SetFrameRate(float frame_rate);
  void EnterPIP();
  [CallWith=ScriptState, RaisesException]
  boolean SetUserAgent(DOMString user_agent);
  [CallWith=ScriptState, RaisesException]
  boolean HasSystemFeature(DOMString feature_name);
  void ShowAlertDialog(DOMString title, DOMString message);
  void PublishHomeScreen(DOMString json);
};
